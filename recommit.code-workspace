{
  "folders": [
    {
      "name": "recommit",
      "path": "."
    }
  ],
  "settings": {
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.formatOnType": true,
    "terminal.integrated.cwd": "${workspaceFolder:recommit}",
    "files.exclude": {
      "**/__pycache__": true,
      "**/.mypy_cache": true,
      "**/.pytest_cache": true,
      "**/.ruff_cache": true
    },
    "[python]": {
      "editor.defaultFormatter": "charliermarsh.ruff",
      "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit",
        "source.fixAll": "explicit"
      }
    },
    "python.defaultInterpreterPath": "${workspaceFolder:recommit}/.venv/bin/python",
    "python.analysis.extraPaths": ["${workspaceFolder:recommit}"],
    "ruff.enable": true,
    "ruff.configuration": "${workspaceFolder:recommit}/pyproject.toml",
    "mypy-type-checker.args": ["--config-file=pyproject.toml"]
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.mypy-type-checker",
      "charliermarsh.ruff"
    ]
  }
}
